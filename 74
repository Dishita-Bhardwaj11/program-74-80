#include <stdio.h>

int main() {
    int r, c;
    scanf("%d %d", &r, &c);

    int matrix[r][c];
    int rowSum[r];
    for (int i = 0; i < r; i++) {
        for (int j = 0; j < c; j++) {
            scanf("%d", &matrix[i][j]);
        }
    }

    for (int i = 0; i < r; i++) {
        int sum = 0;
        for (int j = 0; j < c; j++) {
            sum += matrix[i][j];
        }
        rowSum[i] = sum;
    }

    for (int i = 0; i < r; i++) {
        printf("%d ", rowSum[i]);
    }

    return 0;
}
