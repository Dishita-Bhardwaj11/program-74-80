#include <stdio.h>

int main() {
    int r, c;
    scanf("%d %d", &r, &c);

    int matrix[r][c];

   
    for (int i = 0; i < r; i++) {
        for (int j = 0; j < c; j++) {
            scanf("%d", &matrix[i][j]);
        }
    }

    if (r != c) {
        return 0;
    }

    int sum = 0;

    for (int i = 0; i < r; i++) {
        sum += matrix[i][i];
    }

    printf("%d", sum);

    return 0;
}
