#include <stdio.h>

int main() {
    int r, c;
    scanf("%d %d", &r, &c);

    int matrix[r][c];

 
    for (int i = 0; i < r; i++) {
        for (int j = 0; j < c; j++) {
            scanf("%d", &matrix[i][j]);
        }
    }

    if (r != c) {
        printf("False");
        return 0;
    }

    for (int i = 0; i < r; i++) {
        for (int j = i + 1; j < r; j++) {
            if (matrix[i][i] == matrix[j][j]) {
                printf("False");
                return 0;
            }
        }
    }

    printf("True");
    return 0;
}

